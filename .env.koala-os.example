# ====================================================================
# Extensión Koala OS para whatsapp-agentkit
#
# Este archivo NO viene en el repo original. Lo agrego para que cuando
# corras `/build-agent` Claude Code sume estas variables al .env final
# (o las pegues vos mismo después).
#
# El agente, una vez generado, debe importar estas variables y usarlas
# en agent/tools.py (o en un módulo agent/koala_sync.py) para hacer
# POST/UPSERT a Supabase cada vez que reciba un mensaje nuevo.
# ====================================================================

# ── Supabase (Koala OS) ─────────────────────────────────────────────
# URL del proyecto Supabase (la misma del .env.local del frontend).
SUPABASE_URL=https://<ref>.supabase.co

# Service role key (NO la anon key). Necesaria para INSERTAR en
# crm_leads sin tener sesión de usuario. Tratar como secret crítico.
SUPABASE_SERVICE_ROLE_KEY=

# ID de la sucursal de Koala donde se crearán los leads.
# Coincide con KOALA_LOCATIONS[].id en el frontend.
# Ejemplos: loc-pilar | loc-palermo | loc-norte
KOALA_LOCATION_ID=loc-pilar

# Canal por defecto para los leads creados desde este agente.
# Valores válidos en crm_leads.canal: whatsapp | instagram | email
KOALA_DEFAULT_CHANNEL=whatsapp

# (Opcional) origen detallado que se guarda en crm_leads.fuente_detalle
KOALA_LEAD_SOURCE=Agente IA WhatsApp

# Tiempo (en minutos) que mantiene un lead "abierto" sin actividad antes
# de cerrarlo por timeout y empezar uno nuevo en la siguiente interacción.
# El agente también cierra leads cuando detecta cambio de intent (reserva
# → cancelación, etc.). Default sugerido: 1440 (24 h).
KOALA_INTENT_TIMEOUT_MIN=1440

# ── Outbound (botón Enviar del operador en Koala OS) ─────────────────
# Shared secret compartido con la Edge Function `wa-send-operator-message`
# de Supabase. Debe coincidir exactamente con KOALA_OUTBOUND_SECRET en
# los Secrets del proyecto Supabase. Tratar como secret crítico.
#
# Sin esta variable, el endpoint POST /outbound/send del agente rechaza
# cualquier pedido con 503 y el operador no puede responder desde la UI.
KOALA_OUTBOUND_SECRET=
